---
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import {readImageFocus} from '../../lib/image-focus.mjs';
import HeroWave from '../../components/HeroWave.astro';
import Banner from '../../components/Banner.astro';
import DestinationTrips from '../../components/DestinationTrips.astro';
import {isDestination} from '../../lib/destination-trips.mjs';
import SideIcon from '../../components/SideIcon.astro';
import {posts,href} from '../../lib/posts';
import {categoryText,postCategories} from '../../lib/categories.mjs';
import {db,asPost,articleBody,authenticated} from '../../server/cms.mjs';
const preview=Astro.url.searchParams.has('preview')&&authenticated(Astro.cookies.get('bcift_session')?.value);
const row=db.prepare('SELECT * FROM articles WHERE slug=?').get(Astro.params.slug);
const post=row ? ((row.status==='published'||preview)?asPost(row):null) : (await posts()).find(p=>p.id===Astro.params.slug);
if(!post)return new Response('Article not found',{status:404,headers:{'X-Robots-Tag':'noindex'}});
Astro.response.headers.set('Cache-Control','no-store');
const rendered=post.cms?null:await render(post);
const Content=rendered?.Content;
const cmsBody=post.cms?articleBody(post.body):null;
const destinationTrips=isDestination(postCategories(post.data))?post.data.destinationTrips??[]:[];
const headings=cmsBody?.headings??rendered?.headings??[];
const related=(await posts()).filter(p=>p.id!==post.id).slice(0,3);
const imageFocus=readImageFocus(post.data.imageFocus);
const url=new URL(href(post.id),Astro.site).href;
const schema={'@context':'https://schema.org','@graph':[{'@type':'BlogPosting',articleSection:postCategories(post.data),headline:post.data.title,keywords:post.data.keywords||undefined,description:post.data.description,image:new URL(post.data.image,Astro.site).href,mainEntityOfPage:url,author:{'@type':'Organization',name:post.data.author},publisher:{'@type':'Organization',name:'BCIFT',url:'https://bcift.co.id'},...(post.data.publishedAt?{datePublished:post.data.publishedAt.toISOString()}:{}),...(post.data.updatedAt?{dateModified:post.data.updatedAt.toISOString()}:{} )},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://bcift.co.id/'},{'@type':'ListItem',position:2,name:'Blog',item:'https://bcift.co.id/blog/'},{'@type':'ListItem',position:3,name:post.data.title,item:url}]}]};
---
<Base title={post.data.seoTitle||post.data.title} description={post.data.description} image={post.data.image} noindex={post.data.draft} article schema={schema} imageAlt={post.data.imageAlt} publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt}>
<div class="blog-hero article-cover-hero" style={`--cover-x:${imageFocus.desktop.x}%;--cover-y:${imageFocus.desktop.y}%;--cover-mobile-x:${imageFocus.mobile.x}%;--cover-mobile-y:${imageFocus.mobile.y}%`}><img src={post.data.image} alt={post.data.imageAlt} width="1600" height="900" fetchpriority="high"/><HeroWave/></div>
<div class="article-wrap article-wide">
<div class="article-columns">
<article class="article-main">
<nav class="crumb" aria-label="Breadcrumb"><a href="https://bcift.co.id/">Home</a> / <a href="/blog/">Blog</a> / <span>{categoryText(post.data)}</span></nav>
<span class="tag">{categoryText(post.data)}</span><h1>{post.data.title}</h1>
<div class="article-meta"><span class="meta">{post.data.author}{post.data.publishedAt&&<> · <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-GB',{timeZone:'UTC',day:'numeric',month:'long',year:'numeric'})}</time></>}{post.data.draft&&' · Draft preview'}</span></div>
{destinationTrips.length>0&&<DestinationTrips trips={destinationTrips} class="destination-mobile"/>}
<p class="lead">{post.data.description}</p>{headings.some(h=>h.depth===2)&&<details class="mobile-article-toc"><summary>In this article</summary><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol></details>}<div class="article-body">{cmsBody?<Fragment set:html={cmsBody.html}/>:Content&&<Content/>}</div>
</article>
<aside class="article-sidebar" aria-label="Article resources">
{destinationTrips.length>0&&<DestinationTrips trips={destinationTrips} class="destination-desktop"/>}
{headings.some(h=>h.depth===2)&&<section class="sidebar-panel"><h2><SideIcon kind="list"/>Table of contents</h2><ol class="toc-list">{headings.filter(h=>h.depth===2).map((h,i)=><li><a href={'#'+h.slug}><span>{i+1}</span>{h.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol></section>}
<section class="sidebar-panel"><h2><SideIcon/>Quick information</h2><dl class="quick-facts">{(post.data.quickInfo??[{label:'Topic',value:categoryText(post.data)},{label:'Terminal',value:'Batam Center'},{label:'Planning',value:'Check current operator information'}]).map((fact,i)=><div><SideIcon kind={['route','pin','pin','clock'][i%4]}/><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div></div>)}</dl><p class="sidebar-note">Confirm current details with your ferry operator before travelling.</p></section>
<section class="sidebar-panel"><h2><SideIcon kind="link"/>Useful links</h2><ul class="useful-links"><li><a href="https://bcift.co.id/schedule">Ferry schedule <span>›</span></a></li><li><a href="https://bcift.co.id/ferry-operator">Ferry operators <span>›</span></a></li><li><a href="https://bcift.co.id/">Terminal information <span>›</span></a></li><li><a href="/blog/">More travel guides <span>›</span></a></li></ul></section>
{related.length>0&&<section class="sidebar-panel"><h2><SideIcon kind="article"/>More to explore</h2><div class="sidebar-stories">{related.map(p=><a href={href(p.id)}><img src={p.data.image} alt={p.data.imageAlt} width="100" height="84" loading="lazy"/><div><span class="tag">{categoryText(p.data)}</span><h3>{p.data.title}</h3></div></a>)}</div></section>}
</aside>
</div>
<Banner/>
<section class="related"><div class="section-heading"><h2>Related Articles</h2><a class="read" href="/blog/">View all →</a></div><div class="grid">{related.map(p=><Card post={p}/>)}</div></section>
</div></Base>
