---
import adminMobileStyles from '../../../styles/admin-mobile.css?inline';
import HomepagePanel from '../../../components/admin/HomepagePanel.astro';
import AnalyticsPanel from '../../../components/admin/AnalyticsPanel.astro';
import HeroWave from '../../../components/HeroWave.astro';
import {TRAVEL_MODES} from '../../../lib/destination-trips.mjs';
import {CATEGORY_VALUES,editorCategoryLabel} from '../../../lib/categories.mjs';
import {currentUser,hasAdmin,ensureConfiguredAccounts} from '../../../server/cms.mjs';
import {issueCsrf,secureRequest} from '../../../server/csrf.mjs';
Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
Astro.response.headers.set('Content-Security-Policy',"frame-ancestors 'none'");
const csrf=issueCsrf(Astro.cookies.get('bcift_csrf')?.value);
Astro.cookies.set('bcift_csrf',csrf,{httpOnly:true,sameSite:'strict',secure:secureRequest(Astro.request),path:'/blog/',maxAge:12*3600});
ensureConfiguredAccounts();
const user=currentUser(Astro.cookies.get('bcift_session')?.value);
const logged=!!user;
const setup=!hasAdmin();
---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><meta name="bcift-csrf" content={csrf}/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Blog Studio | BCIFT</title><link rel="icon" href="/favicon.png"/></head><body>
<header><a href="/blog/admin/" class="brand"><img src="/images/logo.png" alt="BCIFT" width="140"/><span>Blog Studio</span></a><div><a href="/blog/" target="_blank">Lihat blog ↗</a>{logged&&<button id="logout" class="quiet">Keluar</button>}</div></header>
<div id="notice" role="status" aria-live="polite"></div>
{!logged?<main class="auth"><p class="eyebrow">BCIFT · INTERNAL TEAM</p>
<section id="signin-panel"><h1>Masuk ke Blog Studio</h1><p>Masuk menggunakan akun internal BCIFT.</p>{setup?<div class="hint"><strong>Akun internal belum dikonfigurasi.</strong><p>Hubungi pengelola server.</p></div>:<form id="login"><label>Email tim<input name="email" type="email" autocomplete="username" required/></label><label>Password<input name="password" type="password" autocomplete="current-password" maxlength="128" required/></label><button class="primary" type="submit">Masuk</button></form>}<small>Tidak ada pendaftaran lewat web. Untuk akses atau reset password, hubungi pengelola tim.</small></section>
<section id="invite-panel" hidden><h1>Reset password BCIFT</h1><p id="invite-detail">Memeriksa link reset…</p><form id="accept-invite" hidden><label>Email<input id="invite-email" type="email" readonly autocomplete="username"/></label><label>Password baru<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required/></label><label>Ulangi password<input name="confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="128" required/></label><small>Minimal 12 karakter. Setelah disimpan, kamu langsung masuk ke dashboard.</small><button class="primary">Simpan password baru</button></form></section>
</main>
:<main class="studio" data-role={user?.role}>
<nav class="studio-menu" aria-label="Menu Blog Studio"><button id="articles-menu" data-studio-view="articles" aria-current="page">Artikel</button>{user?.role==='admin'&&<><button id="analytics-menu" data-studio-view="analytics">Statistik</button><button id="homepage-menu" data-studio-view="homepage">Halaman utama</button><button id="team-toggle" data-studio-view="team">Tim & akses</button></>}</nav>
{user?.role==='admin'&&<section id="homepage-view" hidden><HomepagePanel/></section>}
{user?.role==='admin'&&<section id="analytics-view" hidden><div class="section-top"><div><p class="eyebrow">AKTIVITAS BLOG</p><h1>Statistik pembaca</h1><p>Pantau artikel dibuka, klik artikel, dan bacaan aktif.</p></div></div><AnalyticsPanel/></section>}
{user?.role==='admin'&&<><section id="team-view" hidden><div class="section-top"><div><p class="eyebrow">ADMIN</p><h1>Tim & akses</h1><p>Buat akun internal baru serta atur peran dan status anggota di sini.</p></div><button id="team-close">← Kembali ke artikel</button></div><section class="panel"><h2>Buat akun internal</h2><p class="hint">Admin dapat mengelola artikel dan tim. Editorial/Penulis menulis draft dan mengunggah gambar; penerbitan dilakukan oleh Admin.</p><form id="create-account"><div class="account-fields"><label>Email anggota<input name="email" type="email" autocomplete="off" maxlength="254" required placeholder="nama@bcift.com"/></label><label>Peran<select name="role"><option value="editor">Editorial/Penulis</option><option value="admin">Admin</option></select></label><label>Password awal<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required/></label><label>Ulangi password<input name="confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="128" required/></label></div><small>Gunakan password 12–128 karakter. Setelah dibuat, anggota dapat langsung login menggunakan email dan password tersebut.</small><button type="submit" class="primary" id="create-account-submit">Buat akun</button><p id="create-account-notice" role="status" aria-live="polite"></p></form></section><section class="panel"><h2>Akun yang sudah ada</h2><p>Akun dan akses yang sudah ada tetap dipertahankan. Akun berlabel “Dari kode” tetap dikelola melalui konfigurasi server.</p><div id="invite-result" hidden><label>Link reset password pribadi<textarea id="invite-link" readonly rows="3"></textarea></label><small>Bagikan hanya kepada pemilik akun yang dituju.</small></div></section><section class="panel"><h2>Anggota</h2><div id="members"></div></section><section class="panel"><h2>Link reset yang belum digunakan</h2><div id="pending-invites"></div></section><section class="panel"><h2>Aktivitas terakhir</h2><div id="audit-list"></div></section></section>
</>}<section id="library"><div class="section-top"><div><p class="eyebrow">RUANG REDAKSI</p><h1>Artikel blog</h1><p>Tulis cerita, siapkan SEO, lalu bagikan ke pembaca.</p></div><button id="new" class="primary">+ Artikel baru</button></div><div class="stats"><div><strong id="total">0</strong><span>Total artikel</span></div><div><strong id="published">0</strong><span>Terbit</span></div><div><strong id="drafts">0</strong><span>Draft</span></div></div><div class="filters"><input id="search" type="search" placeholder="Cari judul artikel…" aria-label="Cari artikel"/><select id="status" aria-label="Filter status"><option value="all">Semua status</option><option value="draft">Draft</option><option value="published">Terbit</option></select></div><div id="articles"></div></section>
<section id="editor-view" hidden><div class="section-top"><div><button id="back" class="quiet">← Semua artikel</button><h1 id="editor-heading">Artikel baru</h1><p id="save-state">Belum disimpan</p></div><div class="actions"><a id="preview" hidden target="_blank" rel="noopener">Pratinjau ↗</a><button id="save-draft">Simpan draft</button><button id="publish" class="primary">Terbitkan</button></div></div>
<form id="article-form"><div class="editor-grid"><div class="main-column"><section class="panel"><label>Judul artikel<input name="title" id="title" maxlength="180" placeholder="Cerita apa yang ingin kamu bagikan?" required/></label><label>Slug / alamat artikel<div class="slug"><span>/blog/</span><input name="slug" id="slug" maxlength="100" required/></div></label><label>Ringkasan & meta description<textarea name="description" id="description" maxlength="500" rows="3" placeholder="Ringkasan singkat yang menjelaskan isi artikel."></textarea></label><small id="description-count">0 karakter · umumnya sekitar 140–160 karakter</small></section>
<section class="panel writing"><div class="writing-title"><h2>Isi artikel</h2><small id="word-count">0 kata</small></div><p class="paste-hint">Tempel artikel berformat atau Markdown; heading, daftar, teks tebal, dan tautan akan dipertahankan.</p><div class="tools" role="toolbar" aria-label="Format artikel"><button type="button" data-command="bold"><b>B</b></button><button type="button" data-command="italic"><i>I</i></button><button type="button" data-block="p">Paragraf</button><button type="button" data-block="h2">H2</button><button type="button" data-block="h3">H3</button><button type="button" data-command="insertUnorderedList">• Daftar</button><button type="button" data-block="blockquote">Kutipan</button><button type="button" id="insert-link" title="Blok teks atau klik tautan untuk mengedit; Ctrl+K">Tautan</button><button type="button" id="body-image">Gambar</button><button type="button" data-command="undo">↶</button><button type="button" data-command="redo">↷</button></div><div id="body" contenteditable="true" role="textbox" aria-label="Isi artikel" aria-multiline="true" data-placeholder="Mulai menulis di sini…"></div></section></div>
<aside><section class="panel"><h2>Detail artikel</h2><fieldset id="category-options"><legend>Kategori artikel</legend><p class="hint">Bisa pilih lebih dari satu kategori.</p><div class="category-choices">{CATEGORY_VALUES.map((category,i)=><label><input type="checkbox" name="categories" value={category} checked={i===0}/><span>{editorCategoryLabel(category)}</span></label>)}</div></fieldset><label>Penulis<input name="author" value="BCIFT Editorial" maxlength="100"/></label></section><section class="panel" id="destination-panel" hidden><h2>Estimasi perjalanan destinasi</h2><p class="hint">Dari Batam Center International Ferry Terminal (BCIFT). Opsional; ditampilkan di panel informasi, terpisah dari isi artikel.</p><div id="destination-trips"></div><button type="button" id="add-destination">+ Tambah lokasi tujuan</button><small>Isi estimasi yang sudah kamu cek sesuai moda perjalanan.</small></section><section class="panel"><h2>Gambar utama</h2><img id="cover-preview" hidden alt="Pratinjau gambar utama"/><button id="upload-cover" type="button">Upload gambar</button><button id="adjust-cover" type="button" disabled>Atur crop banner</button><button id="adjust-thumbnail" type="button" disabled>Atur thumbnail</button><small>JPG, PNG, WebP · maksimal 5 MB</small><label>URL gambar<input name="image" id="image" placeholder="https://… atau hasil upload"/></label><label>Deskripsi gambar (alt)<input name="image_alt" maxlength="250" placeholder="Jelaskan isi gambar"/></label></section><section class="panel"><h2>SEO & kata kunci</h2><label>Judul SEO <span>(opsional)</span><input name="seo_title" id="seo-title" maxlength="180" placeholder="Otomatis mengikuti judul artikel"/></label><label>Kata kunci fokus<input name="keywords" id="keywords" maxlength="500" placeholder="Pisahkan dengan koma"/></label><button id="suggest" type="button" class="quiet">Sarankan dari judul</button><p class="hint">Saran berdasarkan kata pada judul, bukan data volume pencarian. Pilih frasa yang cocok dengan isi artikel.</p><div class="serp"><small>bcift.co.id › blog</small><h3 id="serp-title"></h3><p id="serp-description"></p></div><ul id="seo-checks" class="checks"></ul></section><button id="delete" type="button" class="danger" hidden>Hapus artikel</button></aside></div></form>
<template id="destination-template"><fieldset class="destination-row"><legend>Lokasi tujuan</legend><label>Nama tempat<input data-trip="location" maxlength="120" placeholder="Contoh: nama pantai atau tempat wisata" required/></label><div class="destination-fields"><label>Estimasi (menit)<input data-trip="minutes" type="number" min="1" max="1440" step="1" placeholder="20" required/></label><label>Moda perjalanan<select data-trip="transport">{TRAVEL_MODES.map(mode=><option value={mode}>{mode}</option>)}</select></label></div><button type="button" class="quiet remove-destination">Hapus lokasi</button></fieldset></template>
<dialog id="cover-dialog" aria-labelledby="cover-dialog-title"><div class="cover-dialog-heading"><div><h2 id="cover-dialog-title">Atur banner & thumbnail</h2><p>Geser foto atau gunakan pengaturan posisi untuk memilih bagian yang terlihat.</p></div><button type="button" id="close-cover" aria-label="Tutup pengaturan crop">×</button></div><div class="cover-modes" role="group" aria-label="Pratinjau perangkat"><button type="button" data-cover-mode="desktop" aria-pressed="true">Banner desktop</button><button type="button" data-cover-mode="mobile" aria-pressed="false">Banner ponsel</button><button type="button" data-cover-mode="thumbnail" aria-pressed="false">Thumbnail blog</button></div><div id="cover-canvas" data-mode="desktop"><img id="cover-crop-preview" alt="Pratinjau posisi foto pada banner artikel" draggable="false"/><HeroWave/></div><label id="thumbnail-fit-control" hidden>Tampilan thumbnail<select id="thumbnail-fit"><option value="cover">Penuhi frame (crop)</option><option value="contain">Tampilkan gambar utuh</option></select><small>Untuk infografis atau gambar berisi tulisan, pilih “Tampilkan gambar utuh”.</small></label><div class="cover-position-controls"><label>Posisi horizontal <output id="cover-x-value">50%</output><input id="cover-x" type="range" min="0" max="100" step="1"/><small>Kiri ↔ Kanan</small></label><label>Posisi vertikal <output id="cover-y-value">60%</output><input id="cover-y" type="range" min="0" max="100" step="1"/><small>Atas ↔ Bawah</small></label></div><p class="hint" id="cover-mode-hint">Posisi banner dan thumbnail disimpan terpisah.</p><div class="cover-dialog-actions"><button type="button" id="reset-cover">Reset posisi perangkat ini</button><button type="button" id="done-cover" class="primary">Selesai</button></div><small>Setelah selesai, simpan perubahan artikel untuk menerapkan posisi foto.</small></dialog>
<input id="file" type="file" accept="image/jpeg,image/png,image/webp" hidden/>
</section></main>}
<script src="../../../scripts/admin.ts"></script><script src="../../../scripts/internal-login.ts"></script><script src="../../../scripts/team.ts"></script>
<style is:global>
#adjust-thumbnail{margin:0 0 12px}.cover-modes{flex-wrap:wrap}#cover-canvas[data-mode=thumbnail]{max-width:500px;aspect-ratio:1.48;border:1px solid #e0e9ee;border-radius:8px}#cover-canvas[data-mode=thumbnail] .wave{display:none}#thumbnail-fit-control{max-width:500px;margin:0 auto 22px}#thumbnail-fit-control small{margin-top:8px}

.account-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}#create-account-submit{margin-top:18px}#create-account-notice{font-size:13px;margin-top:12px;overflow-wrap:anywhere}#create-account-notice.error{color:#a82323}@media(max-width:650px){.account-fields{grid-template-columns:1fr}}

#cover-dialog{width:min(1000px,94vw);max-height:92dvh;overflow:auto;border:1px solid #cbdce5;border-radius:14px;padding:24px;color:#18364a}#cover-dialog::backdrop{background:#102e46a6}.cover-dialog-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.cover-dialog-heading h2{font-size:21px;margin-bottom:6px}.cover-dialog-heading p{font-size:13px}.cover-dialog-heading button{border:0;font-size:24px;padding:0 8px}.cover-modes{display:flex;gap:8px;margin:18px 0}.cover-modes [aria-pressed=true]{background:#0076a9;color:white;border-color:#0076a9}#cover-canvas{position:relative;isolation:isolate;overflow:hidden;width:100%;aspect-ratio:1440/320;background:#edf5f9;cursor:grab;touch-action:none;margin:0 auto 20px}#cover-canvas:active{cursor:grabbing}#cover-canvas[data-mode=mobile]{max-width:390px;aspect-ratio:390/225}#cover-canvas img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;user-select:none;pointer-events:none}#cover-canvas .wave{position:absolute;bottom:-1px;left:0;width:100%;height:26.25%;pointer-events:none}#cover-canvas[data-mode=mobile] .wave{height:21.33%}.cover-position-controls{display:grid;grid-template-columns:1fr 1fr;gap:24px}.cover-position-controls input{padding:0;accent-color:#0076a9}.cover-position-controls output{float:right;font-weight:400}.cover-dialog-actions{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}#adjust-cover{margin:8px 0 12px}@media(max-width:560px){#cover-dialog{padding:18px}.cover-position-controls{grid-template-columns:1fr;gap:0}.cover-dialog-heading h2{font-size:18px}}

.link-editor{position:fixed;z-index:1200;background:#fff;border:1px solid #c3d9e5;border-radius:12px;padding:16px;box-shadow:0 10px 36px #18364a26;max-height:calc(100dvh - 24px);overflow-y:auto}.link-editor-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.link-editor-heading button{border:0;padding:0 6px;font-size:24px;line-height:1}.link-editor [data-selected]{font-size:12px;color:#526c7c;overflow-wrap:anywhere;margin:8px 0 12px}.link-editor label{font-size:13px;margin:0}.link-editor input{font-size:14px;margin-top:6px}.link-editor-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.link-editor-actions button{font-size:13px;padding:8px 12px}.link-editor [role=alert]{color:#a82323;font-size:12px;margin:8px 0}.link-editor [data-remove]{color:#a82323}#body a{text-decoration:underline;text-underline-offset:3px;cursor:pointer}

#category-options{border:0;padding:0;margin:0 0 20px;min-width:0}#category-options legend{font-weight:650;margin-bottom:5px}.category-choices{display:grid;gap:8px;margin-top:12px}.category-choices label{display:flex;align-items:center;gap:10px;font-weight:400;margin:0;cursor:pointer}.category-choices input{width:17px;height:17px;margin:0;accent-color:#0076a9;flex-shrink:0}
#destination-panel[hidden]{display:none}.destination-row{min-width:0;margin:18px 0;padding:14px;border:1px solid #cbdce5;border-radius:8px}.destination-row legend{font-size:13px;font-weight:700}.destination-fields{display:grid;grid-template-columns:1fr 1.4fr;gap:10px}.destination-fields label{min-width:0}.destination-row .remove-destination{font-size:12px;padding:4px 0;color:#a82323}
.paste-hint{padding:0 24px 14px;font-size:12px;color:#526c7c}#body table{width:100%;border-collapse:collapse;margin:16px 0}#body td,#body th{border:1px solid #d8e6ee;padding:8px;text-align:left}#body th{background:#edf6fb}#body li{margin:7px 0}
.auth code{display:block;word-break:break-all;padding:10px;background:#edf5f9;font-size:13px;margin-top:8px}#mfa-qr{max-width:100%;height:auto}.ack{display:flex;gap:10px;align-items:center;margin-top:20px}.ack input{width:auto;margin:0}#recovery-codes{background:#edf5f9;padding:16px;font-size:15px;line-height:1.8;white-space:pre-wrap}.team-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 0;border-bottom:1px solid #e0e9ee}.team-row>div{min-width:0;overflow-wrap:anywhere}.team-row .controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.team-row select{width:auto;margin:0}.invite-form{display:grid;grid-template-columns:1fr 140px auto;align-items:end;gap:14px}.invite-form label{margin:0}#invite-result textarea{word-break:break-all}#team-view{margin-bottom:30px}#audit-list{max-height:350px;overflow:auto}#audit-list p{padding:9px 0;border-bottom:1px solid #e0e9ee;font-size:13px}@media(max-width:700px){.invite-form{grid-template-columns:1fr}.team-row{align-items:flex-start;flex-direction:column}header{padding-inline:18px}header>div{gap:6px}header>div a{display:none}}
*{box-sizing:border-box}body{margin:0;font:15px/1.6 system-ui,sans-serif;background:#f3f7fa;color:#18364a}button,input,textarea,select{font:inherit}button,a,input,textarea,select{outline-offset:4px}a{color:#006c9d;text-decoration:none}button{cursor:pointer;background:white;border:1px solid #cbdce5;border-radius:9px;padding:10px 16px;color:#18364a;font-weight:600}button:disabled{opacity:.55;cursor:wait}.primary{background:#0076a9;border-color:#0076a9;color:white}.quiet{background:transparent;border-color:transparent}.danger{color:#a82323;border-color:#eacaca}.brand{display:flex;align-items:center;gap:24px;color:#18364a;font-weight:700}.brand img{object-fit:contain}header{height:88px;display:flex;align-items:center;justify-content:space-between;background:white;padding:16px 5%;border-bottom:1px solid #e0e9ee}header>div{display:flex;align-items:center;gap:20px}h1,h2,h3,p{margin:0}h1{font-size:32px;line-height:1.25}h2{font-size:17px;margin-bottom:18px}h3{font-size:17px}.eyebrow{font-size:11px;letter-spacing:2px;color:#0076a9;font-weight:750;margin-bottom:10px}p{color:#516b7c}.auth{max-width:460px;margin:65px auto;padding:34px;background:white;border:1px solid #e0e9ee;border-radius:18px}.auth p{margin:12px 0 24px}.auth button{width:100%;margin-top:15px}label{display:block;font-weight:600;font-size:13px;margin-bottom:18px}label span{font-weight:400}input,textarea,select{display:block;width:100%;padding:11px 12px;margin-top:7px;border:1px solid #cbdce5;border-radius:8px;background:white;color:#18364a}textarea{resize:vertical}small{font-size:12px;color:#526c7c;display:block}#notice:empty{display:none}#notice{position:sticky;top:0;z-index:20;padding:12px 5%;background:#dceff8;color:#164b68}#notice.error{background:#fff0ed;color:#9e2626}.studio{max-width:1320px;margin:auto;padding:40px 32px 80px}.section-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.section-top p{margin-top:8px}.stats{display:flex;gap:20px;margin:24px 0}.stats>div{background:white;border:1px solid #e0e9ee;flex:1;border-radius:12px;padding:20px}.stats strong{font-size:28px;display:block}.stats span{font-size:13px;color:#526c7c}.filters{display:flex;gap:14px;margin-bottom:22px}.filters input{margin:0;max-width:480px}.filters select{width:auto;margin:0}.article-row{display:flex;align-items:center;justify-content:space-between;gap:20px;background:white;border:1px solid #e0e9ee;border-radius:12px;padding:20px;margin-bottom:12px}.article-row small{margin-top:5px}.badge{border-radius:20px;background:#e9f2f7;padding:4px 10px;font-size:12px;margin-right:12px}.badge.live{background:#dcf2e7;color:#18613c}.empty{padding:60px 24px;text-align:center;border:1px dashed #c5d6df;border-radius:12px}.actions{display:flex;gap:12px;align-items:center}.editor-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px}.panel{background:white;border:1px solid #e0e9ee;border-radius:12px;padding:24px;margin-bottom:22px}.panel label:last-child{margin-bottom:0}.slug{display:flex;align-items:center;gap:4px}.slug input{flex:1;min-width:0}.writing{padding:0;overflow:hidden}.writing-title{display:flex;justify-content:space-between;align-items:center;padding:20px 24px}.writing-title h2{margin:0}.tools{display:flex;gap:5px;flex-wrap:wrap;padding:12px;background:#f6fafc;border-block:1px solid #e0e9ee}.tools button{padding:6px 10px;font-size:13px}#body{min-height:440px;padding:25px;outline:none;font-size:16px;line-height:1.85;overflow-wrap:anywhere}#body:empty:before{content:attr(data-placeholder);color:#718591;pointer-events:none}#body h2{font-size:24px;margin:20px 0 10px}#body h3{margin:16px 0 8px}#body p{margin:12px 0;color:inherit}#body img{max-width:100%;height:auto}#body blockquote{border-left:3px solid #008acb;margin:18px 0;padding-left:18px}#cover-preview{width:100%;max-height:180px;object-fit:cover;border-radius:8px;margin-bottom:12px}.hint{font-size:12px;margin:10px 0 18px}.serp{border-top:1px solid #e0e9ee;padding-top:16px;overflow-wrap: