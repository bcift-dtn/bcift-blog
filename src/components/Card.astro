---
import {createAnalyticsToken} from '../server/analytics.mjs';
import type { posts } from '../lib/posts';
import {thumbnailFocus,thumbnailStyle} from '../lib/image-focus.mjs';
import { href } from '../lib/posts';
import {postCategories,categoryText} from '../lib/categories.mjs';
import {isDestination,readDestinationTrips} from '../lib/destination-trips.mjs';
interface Props {post:Awaited<ReturnType<typeof posts>>[number]}
const {post:p}=Astro.props;
const categories=postCategories(p.data);
const category=categoryText(p.data);
const trip=isDestination(categories)?readDestinationTrips(p.data.destinationTrips)[0]:undefined;
const transportIcons:Record<string,string>={
 'Mobil / taksi':'M3 11l2-6h14l2 6v6H3v-6Zm0 0h18M7 14h.01M17 14h.01M5 17v3M19 17v3',
 'Sepeda motor':'M8 16a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm16 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 16l5-7h7l4 7M7 6h4M9 9l4 7H4M16 9l-2-5h4',
 'Jalan kaki':'M14 4a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM7 13l3-5 4 1 3 4h4M10 8l-1 8-4 5M9 16l5-3 2 8',
 'Ferry / kapal':'M4 13l8-3 8 3-2 6H6l-2-6Zm4-2V5h8v6M12 5V2M2 22l3-1 4 1 3-1 3 1 4-1 3 1'
};
---
<a class="card" data-stat-click={createAnalyticsToken(p.id,'click')} href={href(p.id)} data-title={p.data.title.toLowerCase()} data-categories={JSON.stringify(categories)}>
<div class:list={["card-image",{"card-image-contain":thumbnailFocus(p.data.imageFocus).fit==='contain'}]}><img class="photo" style={thumbnailStyle(p.data.imageFocus)} src={p.data.image} alt={p.data.imageAlt} width="720" height="480" loading="lazy"/></div>
<div class="card-copy"><span class="tag">{category}</span><h3>{p.data.title}</h3>
<div class="meta card-meta">
 <span class="card-meta-date"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v5m10-5v5M3 11h18"/></svg>{p.data.publishedAt?<time datetime={p.data.publishedAt.toISOString()}>{p.data.publishedAt.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time>:<span>Preview article</span>}</span>
 {trip&&<span class="card-trip-time" title={`Estimasi ± ${trip.minutes} menit dari BCIFT ke ${trip.location} · ${trip.transport}. Waktu dapat berubah sesuai kondisi perjalanan.`}><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={transportIcons[trip.transport]}/></svg><span>± {trip.minutes} menit dari BCIFT</span></span>}
</div>
<p>{p.data.description}</p><span class="read">Read more <span aria-hidden="true">→</span></span></div></a>
