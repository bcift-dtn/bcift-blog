---
import type { posts } from '../lib/posts';
import { href } from '../lib/posts';
import {postCategories,categoryText} from '../lib/categories.mjs';
interface Props {post:Awaited<ReturnType<typeof posts>>[number]}
const {post:p}=Astro.props;
const categories=postCategories(p.data);
const category=categoryText(p.data);
---
<a class="card" href={href(p.id)} data-title={p.data.title.toLowerCase()} data-categories={JSON.stringify(categories)}>
<div class="card-image"><img class="photo" src={p.data.image} alt={p.data.imageAlt} width="720" height="480" loading="lazy"/></div>
<div class="card-copy"><span class="tag">{category}</span><h3>{p.data.title}</h3><div class="meta"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v5m10-5v5M3 11h18"/></svg>{p.data.publishedAt?<time datetime={p.data.publishedAt.toISOString()}>{p.data.publishedAt.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time>:<span>Preview article</span>}</div><p>{p.data.description}</p><span class="read">Read more <span aria-hidden="true">→</span></span></div></a>
