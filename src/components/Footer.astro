---
const contacts = [
  { href: 'https://wa.me/6281170029089', label: '+62 811 7002 9089', icon: 'phone' },
  { href: 'mailto:info@bcift.com', label: 'info@bcift.com', icon: 'mail' },
];
---
<footer class="official-footer">
  <div class="footer-container">
    <div class="footer-one">
      <p>Batam Center International Ferry Terminal is Batam's primary international ferry hub, serving routes to Singapore and Malaysia.</p>
      {contacts.map(contact => <a href={contact.href}><svg aria-hidden="true" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">{contact.icon === 'mail' ? <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></> : <path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a15 15 0 0 1-7-7l2-2-2-5Z"/>}</svg>{contact.label}</a>)}
    </div>
    <div class="footer-two">
      <div class="footer-dropdown"><h3>Company</h3><button class="footer-dropdown-btn" aria-label="Toggle company links" aria-controls="footer-company-links" aria-expanded="false"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></button></div>
      <ul class="footer-links-two" id="footer-company-links"><li><a href="https://bcift.co.id/about">About us</a></li></ul>
    </div>
    <div class="mobile-contact">{contacts.map(contact => <a href={contact.href}><svg aria-hidden="true" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">{contact.icon === 'mail' ? <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></> : <path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a15 15 0 0 1-7-7l2-2-2-5Z"/>}</svg>{contact.label}</a>)}</div>
  </div>
  <p class="copyright">Copyrights ©{new Date().getFullYear()} Batam Center International Ferry Terminal. All rights reserved</p>
</footer>
<script>
const button = document.querySelector<HTMLButtonElement>('.footer-dropdown-btn')!;
const links = document.querySelector<HTMLElement>('#footer-company-links')!;
const mobile = matchMedia('(max-width:1010px)');
button.addEventListener('click', () => {
  if (!mobile.matches) return;
  const open = button.getAttribute('aria-expanded') !== 'true';
  button.setAttribute('aria-expanded', String(open));
  links.classList.toggle('open', open);
});
function resetFooter() {
  links.classList.remove('open');
  button.setAttribute('aria-expanded', String(!mobile.matches));
}
mobile.addEventListener('change', resetFooter);
resetFooter();
</script>
<style>
/* BCIFT footer stylesheet, scoped so editorial styles cannot override it. */
.official-footer .mobile-contact{display:none}
.official-footer *{color:white;font-size:28px}
.official-footer{display:flex;flex-direction:column;justify-content:space-between;width:100%;padding:50px 90px 0;background-image:linear-gradient(258deg,#55AEDF,#0C4A6E 100%);gap:0;font-family:Nunito,Arial,sans-serif}
.footer-container{display:flex;width:100%}
.footer-dropdown{display:flex}
.footer-dropdown-btn{display:none}
.footer-one{flex:1;display:flex;flex-direction:column;gap:15px;margin-right:auto;margin-top:0}
.footer-one p{max-width:500px;margin:0 0 20px;font-size:1rem;line-height:2.2rem}
.footer-one a{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:1rem}
.footer-one a svg{width:25px;height:25px;flex-shrink:0}
.official-footer h3{font-weight:900;font-family:Arimo,Arial,sans-serif;font-size:1.5rem;margin:0}
.official-footer ul{display:flex;flex-direction:column;align-items:flex-start;gap:2px;list-style:none;margin:0;padding:0}
.official-footer ul a{color:#fff;font-size:1rem;text-decoration:none}
.footer-two{flex:1;display:flex;flex-direction:column;gap:1rem}
.official-footer .copyright{margin:50px 0 0;padding-bottom:10px;text-align:center;color:white;font-size:.8rem}
@media(max-width:1010px){
.official-footer{flex-direction:column;padding:.8em 2em}
.footer-container{flex-direction:column;gap:1em}
.footer-one{align-items:center;width:100%}
.footer-one p{max-width:90%;margin-bottom:0;text-align:center}
.footer-one a{display:none}
.footer-dropdown{justify-content:space-between;align-items:center}
.footer-dropdown-btn{display:flex;align-items:center;justify-content:center;background:none;border:0;padding:8px;width:44px;min-height:44px;cursor:pointer}
.footer-dropdown-btn svg{width:1.2em;transition:transform .2s}
.footer-dropdown-btn[aria-expanded=true] svg{transform:rotate(180deg)}
.official-footer .footer-links-two{display:none}
.official-footer .footer-links-two.open{display:flex}
.official-footer .mobile-contact{display:flex;justify-content:center;align-items:center;gap:1.5em;flex-wrap:wrap}
.official-footer .mobile-contact>a{display:flex;align-items:center;text-decoration:none;font-size:.7em;gap:4px}
}
@media(max-width:520px){.official-footer{padding:.8em 1.5em}.official-footer .mobile-contact>a{font-size:.5em}}
@media(max-width:470px){.footer-one p{max-width:100%;font-size:.8rem;line-height:1.8rem}.mobile-contact svg{width:25px;flex-shrink:0;margin-right:2px}.official-footer .mobile-contact>a{font-size:.4em}.official-footer .copyright{font-size:.6rem;margin-top:40px}}
@media(prefers-reduced-motion:reduce){.footer-dropdown-btn svg{transition:none}}
</style>
