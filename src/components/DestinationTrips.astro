---
import {transportLabel} from '../lib/blog-language.mjs';
import SideIcon from './SideIcon.astro';
interface Props {trips:Array<{location:string;minutes:number;transport:string}>; class?:string; language?:string}
const {trips,class:className,language='id'}=Astro.props;
const id=language==='id';
---
<section class:list={['sidebar-panel','destination-info',className]} aria-label={id?'Estimasi perjalanan destinasi':'Estimated travel time'}>
 <h2><SideIcon kind="clock"/>{id?'Estimasi perjalanan':'Estimated travel time'}</h2>
 <p class="destination-origin">{id?'Dari BCIFT':'From BCIFT'} · Batam Center</p>
 <ul class="destination-locations">{trips.map(trip=><li><SideIcon kind="pin"/><div><h3>{trip.location}</h3><p><strong>± {trip.minutes} {id?'menit':'minutes'}</strong><span>{transportLabel(trip.transport,language)}</span></p></div></li>)}</ul>
 <p class="sidebar-note">{id?'Waktu tempuh merupakan perkiraan dan dapat berubah sesuai kondisi perjalanan.':'Travel times are estimates and may vary.'}</p>
</section>
