---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {title:string;description:string;image?:string;noindex?:boolean;schema?:Record<string,unknown>;article?:boolean;imageAlt?:string;publishedAt?:Date;updatedAt?:Date}
const {title,description,image='/images/terminal.webp',noindex=false,schema,article=false,imageAlt=title,publishedAt,updatedAt}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const imageUrl=new URL(image,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | BCIFT</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/><meta property="og:image:alt" content={imageAlt}/><meta name="twitter:image:alt" content={imageAlt}/><meta property="og:locale" content="en_US"/>{article&&publishedAt&&<meta property="article:published_time" content={publishedAt.toISOString()}/>} {article&&updatedAt&&<meta property="article:modified_time" content={updatedAt.toISOString()}/>}<link rel="icon" href="/favicon.png"/><meta property="og:site_name" content="BCIFT Travel Journal"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/>{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}</head><body><div class="site-shell"><a class="skip" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/></div></body></html>
