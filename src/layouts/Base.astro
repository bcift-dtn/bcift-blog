---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {title:string;description:string;image?:string;noindex?:boolean;schema?:Record<string,unknown>;article?:boolean;analyticsToken?:string;language?:string;languagePaths?:Record<string,string>;indexAlternates?:boolean;imageAlt?:string;publishedAt?:Date;updatedAt?:Date}
const {title,description,image='/images/terminal.webp',noindex=false,schema,article=false,analyticsToken,language='en',languagePaths,indexAlternates=true,imageAlt=title,publishedAt,updatedAt}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const imageUrl=new URL(image,Astro.site);
---
<!doctype html><html lang={language}><head><meta charset="utf-8"/>{analyticsToken&&<meta name="bcift-article-stat" content={analyticsToken}/>}<meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | BCIFT</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{!noindex&&indexAlternates&&languagePaths?.id&&languagePaths.en&&Object.entries(languagePaths).map(([code,path])=><link rel="alternate" hreflang={code} href={new URL(path,Astro.site)}/>)}<meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/><meta property="og:image:alt" content={imageAlt}/><meta name="twitter:image:alt" content={imageAlt}/><meta property="og:locale" content={language==='id'?'id_ID':'en_US'}/>{article&&publishedAt&&<meta property="article:published_time" content={publishedAt.toISOString()}/>} {article&&updatedAt&&<meta property="article:modified_time" content={updatedAt.toISOString()}/>}<link rel="icon" type="image/png" sizes="96x96" href="/blog/favicon.png"/><meta property="og:site_name" content="BCIFT Travel Journal"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/>{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}</head><body><div class="site-shell"><a class="skip" href="#main">{language==='id'?'Lewati ke konten':'Skip to content'}</a><Header language={languagePaths?language:undefined}/><main id="main"><slot/></main><Footer language={language}/></div><script src="../scripts/analytics-public.mjs"></script></body></html>
